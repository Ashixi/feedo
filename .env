# --- База Даних (для Python API та P2P ноди) ---
POSTGRES_USER=feedo_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=feedo

# --- Безпека та Криптографія ---
INGEST_API_KEY=your_secure_ingest_key_here
NODE_WALLET_PRIVATE_KEY=your_private_key_here

# --- Налаштування Мережі (P2P та Web3) ---
# Надійний публічний RPC для взаємодії зі смарт-контрактами токеноміки на Polygon
POLYGON_RPC_URL=https://polygon-rpc.com

# Вкажіть тут IP головної ноди для підключення.
# Якщо залишити пустим - ця нода стане першою "Genesis" нодою нової мережі.
# Докер сам автоматично зчитує цю змінну з .env файлу і передає її в контейнер feedo-p2p.
# Приклад: /ip4/1.2.3.4/udp/8040/quic-v1/p2p/12D3KooWG...
BOOTSTRAP_NODES=

# Окрема змінна для підключення до консенсусної P2P-мережі (порт 8041 за замовчуванням).
# Приклад: /ip4/1.2.3.4/udp/8041/quic-v1/p2p/12D3KooWH...
CONSENSUS_BOOTSTRAP_NODES=

# --- Ідентифікація Ноди ---
NODE_WALLET_ADDRESS=your_wallet_address_here

# (ОБОВ'ЯЗКОВО) Адреса вашого Головного Банку. 
# Саме сюди ця нода буде відправляти звіти про виконану роботу, щоб отримати сатоші.
TREASURY_URL=https://api.feedo.network/api/v1/treasury/report

# --- Внутрішні та Публічні URL ---
# (ОПЦІОНАЛЬНО) Публічна IP-адреса або домен цього сервера.
PUBLIC_API_URL=https://api.feedo.network

# Для Ingester (Наприклад, nostr-bridge)
INGEST_URL=http://feedo-backend:8040/api/v1/ingest/post

# Для зв'язку бекенду з Rust нодою
RUST_CORE_URL=http://feedo-p2p:8041

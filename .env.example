# ============================================================
#  F E E D O   —   .env ШАБЛОН для нової ноди
# ============================================================
#  Скопіюй цей файл у .env та заповни значення
# ============================================================


# ============================================================
#  🔑 КЛЮЧІ — ЗАПОВНИ САМ
#  python scripts/generate_all_keys.py
# ============================================================
NODE_PRIVATE_KEY=
STORAGE_PRIVATE_KEY=
NODE_WALLET_PRIVATE_KEY=
NODE_WALLET_ADDRESS=
POSTGRES_PASSWORD=


# ============================================================
#  ⚪ СПІЛЬНІ ДЛЯ ВСІХ СЕРВІСІВ
# ============================================================
RUST_LOG=info
ETH_RPC_URL=https://polygon-rpc.com

# Консенсус
EPOCH_DURATION_SECS=600
CONSENSUS_DIRECT_MODE=true

# Storage квоти (підлаштуй під розмір диска)
QUOTA_SITES_GB=10
QUOTA_BLOBS_GB=50
QUOTA_SOCIAL_MB=500
QUOTA_PROFILES_MB=100
DHT_RAM_CACHE_LIMIT=2000

# Search
SEARCH_PORT=8000
SEARCH_HOST=0.0.0.0
SEMANTIC_SHARDING_ENABLED=true
SHARD_CENTROID_CACHE_TTL=600
SHARD_CENTROID_UPDATE_THRESHOLD=100
SHARD_FORWARD_TIMEOUT=5.0
EVENT_DRIVEN_CENTROIDS=true
CENTROID_CHANGE_THRESHOLD=0.9

# URL'и
STORAGE_NODE_URL=http://storage-node:3001
GATEWAYS=http://storage-node:3001,wss://api.feedo.ink,wss://api2.feedo.ink
KNOWN_PEERS=https://api.feedo.ink,https://api2.feedo.ink
PUBLIC_API_URL=https://api.feedo.ink
SEARCH_NODE_URL=http://search-node:8000


# ============================================================
#  🌐 БУТСТРАП-НОДИ (multiaddr)
# ============================================================
#
#  Актуальні бутстрап-ноди мережі Feedo:
#
#  ┌─────────────────┬───────────────┬──────────────────────────────────────────────────────────┐
#  │ Домен           │ IP            │ PeerId                                                   │
#  ├─────────────────┼───────────────┼──────────────────────────────────────────────────────────┤
#  │ api.feedo.ink   │ 95.111.245.68 │ Storage:   12D3KooWD1ErU...LPbrp39                       │
#  │                 │               │ Consensus: 12D3KooWHKWy...7gFtg                          │
#  ├─────────────────┼───────────────┼──────────────────────────────────────────────────────────┤
#  │ api2.feedo.ink  │ 178.18.253.94 │ Storage:   12D3KooWHgoE...RVJwBj                         │
#  │                 │               │ Consensus: 12D3KooWMJfT...kvmMh                          │
#  └─────────────────┴───────────────┴──────────────────────────────────────────────────────────┘
#
#  Якщо ти ПЕРША (генезис) нода — залиш ці поля порожніми.
#  Якщо приєднуєшся до мережі — розкоментуй рядки нижче.

# Storage Node bootstrap (порт 8040/udp)
# BOOTSTRAP_NODES=/ip4/95.111.245.68/udp/8040/quic-v1/p2p/12D3KooWD1ErUyHizJHEP2KzSfGxbLS9wN88vVUpM7FeyLPbrp39,/ip4/178.18.253.94/udp/8040/quic-v1/p2p/12D3KooWHgoEKnniktRFUuYXw6zZFJhKEvgK7ajJXYZpGYRVJwBj

# Consensus Node bootstrap (порт 8041/udp)
# CONSENSUS_BOOTSTRAP_NODES=/ip4/95.111.245.68/udp/8041/quic-v1/p2p/12D3KooWHKWyZDgVpw65ruHBFvHwXSJ5LHGKTHn7DYbtrwo7gFtg,/ip4/178.18.253.94/udp/8041/quic-v1/p2p/12D3KooWMJfThcTD3GiKMz4ihKkZHG3iYZKoaNTxFdTJV49kvmMh


# ============================================================
#  ⚪ ЗОВНІШНІ — API ключі та токени
# ============================================================
RSS_NODE_SECRET=
INGEST_API_KEY=
ALBY_BEARER_TOKEN=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=